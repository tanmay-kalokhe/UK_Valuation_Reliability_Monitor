[sqlfluff]
dialect = duckdb
templater = placeholder
max_line_length = 100

# The SQL uses ${name} placeholders filled from config/project_config.yaml by db.sql_params.
# Representative values let sqlfluff parse the files.
[sqlfluff:templater:placeholder]
param_style = flyway_var
raw_price_paid = data/raw/price_paid
raw_epc = data/raw/epc
raw_house_price_index = data/raw/house_price_index
raw_geography = data/raw/geography
interim = data/interim
processed = data/processed
database = data/processed/valuation.duckdb
figures = reports/figures
start_date = 2021-01-01
info_lag_months = 3
history_window_months = 12
min_comparables = 5
floor_area_min = 15.0
floor_area_max = 1000.0
train_start = 2021-01-01
calibration_start = 2025-03-01
test_start = 2025-09-01
test_end = 2026-08-31

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper
